{
  "name": "gfk",
  "version": "1.0.0",
  "description": "GFK - Firebase Crashlytics issue collector and visualiser",
  "scripts": {
    "analyze": "node utils/analyze-logs.js",
    "setup": "npx playwright test --project=setup",
    "discover": "npx playwright test tests/discover-issues.spec.ts",
    "discover:headless": "HEADLESS=true npx playwright test tests/discover-issues.spec.ts",
    "collect": "npx playwright test tests/collect.spec.ts",
    "collect:headless": "HEADLESS=true npx playwright test tests/collect.spec.ts",
    "test": "npx playwright test",
    "serve": "node server.js",
    "tui": "node tui/index.js",
    "tui:web": "ttyd -W -t fontSize=16 -p 7681 node tui/index.js",
    "push-data": "git add data/issues_3.7.0.csv data/events_3.7.0.csv data/logs/ index.html && git diff --cached --quiet && echo 'Nothing to push.' || (git commit -m 'data: update collected events' && git push)"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.14",
    "dotenv": "^16.4.0",
    "papaparse": "^5.4.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  }
}
