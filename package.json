{
  "name": "gfk",
  "version": "1.0.0",
  "description": "GFK - Firebase Crashlytics issue collector and visualiser",
  "scripts": {
    "analyze": "node utils/analyze-logs.js",
    "setup": "npx ts-node --project tsconfig.json auth/setup.ts",
    "discover": "npx playwright test tests/discover-issues.spec.ts",
    "discover:headless": "HEADLESS=true npx playwright test tests/discover-issues.spec.ts",
    "collect": "npx playwright test tests/collect.spec.ts",
    "collect:headless": "HEADLESS=true npx playwright test tests/collect.spec.ts",
    "test": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.4.0",
    "papaparse": "^5.4.1",
    "@types/papaparse": "^5.3.14"
  }
}