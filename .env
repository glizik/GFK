# Firebase Crashlytics Configuration
# Firebase project config
FIREBASE_PROJECT=webszigno-dev-1532086359290
FIREBASE_APP=ios:hu.microsec.eszigno.mobile

# Query parameters
ISSUE_STATE=open
ISSUE_TIME=90d
ISSUE_TAG=all
ISSUE_SORT=eventCount
ISSUE_VERSIONS=3.6.1 (2662)
ISSUE_TYPES=error
ISSUE_QUERY=FaceKom

# Issue to track
ISSUE_BASE=FaceKom
ISSUE_TYPE=handleFlow (0)

# Output paths
CSV_OUTPUT=./data/issues.csv
LOGS_DIR=./data/logs

# Browser settings
HEADLESS=false
SLOW_MO=10