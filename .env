# Firebase Crashlytics Configuration
FIREBASE_PROJECT=webszigno-dev-1532086359290
FIREBASE_APP=ios:hu.microsec.eszigno.mobile

# Collect — comma-separated list of issue types to track
ISSUE_TYPES_LIST=handleFlow (0)
#handleFlow (0), failed no available customer (0), disconnected (0), stopAndClear (0)

# Limit per issue type (0 = unlimited)
COLLECT_LIMIT=0

# Query parameters
ISSUE_STATE=open
ISSUE_TAG=all
ISSUE_SORT=eventCount
ISSUE_VERSIONS=3.7.0 (2753)
ISSUE_QUERY_TYPES=error
ISSUE_QUERY=FaceKom

# Issue base (used for link-wrapper match)
ISSUE_BASE=FaceKom

# Default lookback window — only used if no state.json entry exists for this issue type
ISSUE_TIME_DEFAULT=90d
# ISSUE_TIME_FROM=1772668800000
# ISSUE_TIME_TO=1772841599000

# Output paths
CSV_OUTPUT=./data/issues.csv
LOGS_DIR=./data/logs
STATE_FILE=./data/state.json

# Browser settings
HEADLESS=false
